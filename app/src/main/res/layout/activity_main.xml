<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="20dp"
        android:paddingTop="28dp"
        android:paddingEnd="20dp"
        android:paddingBottom="24dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/app_name"
            android:textColor="@color/text"
            android:textSize="36sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:text="@string/tagline"
            style="@style/Hush.Caption"
            android:textSize="16sp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="28dp"
            android:layout_marginBottom="4dp"
            android:text="@string/rescue_heading"
            style="@style/Hush.Overline" />

        <!-- Role cards: the whole card is the button. -->
        <LinearLayout
            android:id="@+id/btnCommander"
            style="@style/Hush.Card"
            android:layout_marginTop="8dp"
            android:background="@drawable/btn_primary"
            android:clickable="true"
            android:focusable="true"
            android:contentDescription="@string/role_commander_title">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/role_commander_title"
                android:textColor="@color/surface"
                android:textSize="22sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="@string/role_commander_desc"
                android:textColor="#DCE7F5"
                android:textSize="15sp" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/btnSensor"
            style="@style/Hush.Card"
            android:background="@drawable/bg_card"
            android:clickable="true"
            android:focusable="true"
            android:foreground="?android:attr/selectableItemBackground"
            android:contentDescription="@string/role_sensor_title">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/role_sensor_title"
                android:textColor="@color/text"
                android:textSize="22sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="@string/role_sensor_desc"
                style="@style/Hush.Caption"
                android:textSize="15sp" />
        </LinearLayout>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="28dp"
            android:layout_marginBottom="8dp"
            android:text="@string/at_home_heading"
            style="@style/Hush.Overline" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <Button
                android:id="@+id/btnAlerts"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginEnd="6dp"
                android:layout_weight="1"
                android:minHeight="60dp"
                android:text="@string/role_alert" />

            <Button
                android:id="@+id/btnHome"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:layout_weight="1"
                android:minHeight="60dp"
                android:text="@string/role_home" />
        </LinearLayout>

        <!-- SOS: text the ambulance (108) with this phone's location; the contact is also texted by an unanswered rescue alert. -->
        <Button
            android:id="@+id/btnReport"
            style="@style/Widget.Hush.Button.Danger"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="28dp"
            android:minHeight="64dp"
            android:text="@string/report_emergency"
            android:textSize="18sp"
            android:textStyle="bold" />

        <Button
            android:id="@+id/sosContact"
            style="@style/Widget.Hush.Button"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/sos_contact_none" />

        <!-- Crash / fall escalation (docs/PLAN-crash.md): up to three contacts, texted and called in order. -->
        <Button
            android:id="@+id/btnContacts"
            style="@style/Widget.Hush.Button"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/contacts_button_none" />

        <TextView
            android:id="@+id/sosResult"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:background="@drawable/bg_panel"
            android:padding="14dp"
            android:visibility="gone"
            style="@style/Hush.Body" />

        <!-- Readiness of the passive wake-up (armed / needs background permission). -->
        <TextView
            android:id="@+id/status"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="28dp"
            android:background="@drawable/bg_panel"
            android:padding="14dp"
            android:text="@string/pick_role"
            style="@style/Hush.Caption" />

        <Button
            android:id="@+id/btnBackground"
            style="@style/Widget.Hush.Button.Primary"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:text="@string/allow_background_button"
            android:visibility="gone" />
    </LinearLayout>
</ScrollView>
