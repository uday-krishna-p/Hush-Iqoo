<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_enabled="false">
        <shape android:shape="rectangle"><solid android:color="@color/surface_muted" /><corners android:radius="14dp" /></shape>
    </item>
    <item android:state_pressed="true">
        <shape android:shape="rectangle"><solid android:color="@color/danger_soft" /><corners android:radius="14dp" /><stroke android:width="1dp" android:color="@color/danger" /></shape>
    </item>
    <item>
        <shape android:shape="rectangle"><solid android:color="@color/surface" /><corners android:radius="14dp" /><stroke android:width="1dp" android:color="@color/danger" /></shape>
    </item>
</selector>
