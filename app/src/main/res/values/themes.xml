<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Light, calm theme for every screen; rounded buttons everywhere (the default button style below). -->
    <style name="Theme.Hush" parent="Theme.AppCompat.Light.NoActionBar">
        <item name="colorPrimary">@color/primary</item>
        <item name="colorPrimaryDark">@color/bg</item>
        <item name="colorAccent">@color/primary</item>
        <item name="colorControlActivated">@color/primary</item>
        <item name="android:windowBackground">@color/bg</item>
        <item name="android:statusBarColor">@color/bg</item>
        <item name="android:navigationBarColor">@color/bg</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:windowLightNavigationBar">true</item>
        <item name="android:textColorPrimary">@color/text</item>
        <item name="android:textColorSecondary">@color/text_secondary</item>
        <item name="android:textColor">@color/text</item>
        <item name="buttonStyle">@style/Widget.Hush.Button</item>
        <item name="android:buttonStyle">@style/Widget.Hush.Button</item>
    </style>

    <!-- Buttons: rounded, no shadow, normal case, at least 52 dp tall (easy to hit). -->
    <style name="Widget.Hush.Button" parent="Widget.AppCompat.Button">
        <item name="android:background">@drawable/btn_secondary</item>
        <item name="android:textColor">@color/btn_text_secondary</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textSize">16sp</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:minHeight">52dp</item>
        <item name="android:paddingStart">16dp</item>
        <item name="android:paddingEnd">16dp</item>
        <item name="android:stateListAnimator">@null</item>
    </style>
    <style name="Widget.Hush.Button.Primary">
        <item name="android:background">@drawable/btn_primary</item>
        <item name="android:textColor">@color/surface</item>
    </style>
    <style name="Widget.Hush.Button.Danger">
        <item name="android:background">@drawable/btn_danger</item>
        <item name="android:textColor">@color/btn_text_danger</item>
    </style>

    <!-- Text -->
    <style name="Hush.Card" parent="">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:orientation">vertical</item>
        <item name="android:background">@drawable/bg_card</item>
        <item name="android:padding">18dp</item>
        <item name="android:layout_marginTop">12dp</item>
    </style>
    <style name="Hush.Overline" parent="">
        <item name="android:textSize">13sp</item>
        <item name="android:textColor">@color/text_secondary</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:letterSpacing">0.06</item>
        <item name="android:textAllCaps">true</item>
    </style>
    <style name="Hush.Body" parent="">
        <item name="android:textSize">16sp</item>
        <item name="android:textColor">@color/text</item>
        <item name="android:lineSpacingExtra">2dp</item>
    </style>
    <style name="Hush.Caption" parent="">
        <item name="android:textSize">14sp</item>
        <item name="android:textColor">@color/text_secondary</item>
        <item name="android:lineSpacingExtra">2dp</item>
    </style>
    <style name="Hush.Mono" parent="">
        <item name="android:textSize">13sp</item>
        <item name="android:textColor">@color/text_secondary</item>
        <item name="android:fontFamily">monospace</item>
    </style>
</resources>
